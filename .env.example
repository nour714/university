# Database Pooler URLs (Port 6543, Transaction Mode)
DATABASE_URL_APP="postgresql://academic_app.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require"
DATABASE_URL_GRADER="postgresql://academic_grader.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require"

# Database Connection Tuning
DB_SSL="require"
DB_POOL_MAX="2"

# Security & Secrets (Server-only - Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" or openssl rand -base64 32)
APP_SECRET="generate-64-character-hex-string-for-rate-limiting-hmac"
CODE_PEPPER="generate-64-character-hex-string-for-hmac-peppering"
CRON_SECRET="generate-64-character-hex-string-for-cron-verification"

# Server Actions & Allowed Origins (comma-separated, optional)
ALLOWED_ORIGINS="https://your-project.vercel.app,https://yourdomain.edu.eg"

# Cloudflare R2 / S3-compatible Object Storage (Optional)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="academic-files"

# Cloudflare Turnstile Anti-Bot Protection (Optional)
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"

# Local CLI Scripts / Migrations Only (NEVER set on Vercel runtime)
# DATABASE_URL_OWNER="postgresql://postgres:<your-owner-password>@localhost:5432/postgres?sslmode=disable"
